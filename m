|
-if (tty_write_lock(tty, expr) < 0) stmnt;
-if (ret < 0) stmnt
+ret =3D tty_write_lock(tty, expr);
+if (ret) stmnt
|
-ret =3D usb_lock_device_for_reset(expr1, expr2);
-if (ret < 0) stmnt
+ret =3D usb_lock_device_for_reset(expr1, expr2);
+if (ret) stmnt
|
-ret =3D usb_lock_device_for_reset(expr1, expr2);
-if (ret < 0) stmnt1 else stmnt2
+ret =3D usb_lock_device_for_reset(expr1, expr2);
