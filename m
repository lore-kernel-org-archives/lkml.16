|
-ret =3D usb_lock_device_for_reset(expr1, expr2);
-if (ret >=3D 0) stmnt
+ret =3D usb_lock_device_for_reset(expr1, expr2);
+if (ret =3D=3D 0) stmnt
|
-ret =3D usb_lock_device_interruptible(expr);
-if (ret < 0) stmnt
+ret =3D usb_lock_device_interruptible(expr);
+if (ret) stmnt
|
-ret =3D usblp_rwait_and_lock(mutex, expr);
-if (ret < 0) stmnt
+ret =3D usblp_rwait_and_lock(mutex, expr);
+if (ret) stmnt
)

